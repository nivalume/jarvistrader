{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "JARVIS_BUILD_PYTHON": "ON",
        "JARVIS_BUILD_LIVE": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Debug with ASan and UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JARVIS_BUILD_TESTS": "ON",
        "JARVIS_BUILD_BENCHMARKS": "ON",
        "JARVIS_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "rel",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "JARVIS_BUILD_TESTS": "ON",
        "JARVIS_BUILD_BENCHMARKS": "OFF",
        "JARVIS_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "det-o0",
      "inherits": "base",
      "displayName": "Determinism comparison build at O0",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JARVIS_BUILD_TESTS": "ON",
        "JARVIS_BUILD_BENCHMARKS": "OFF",
        "JARVIS_ENABLE_SANITIZERS": "OFF",
        "JARVIS_FORCE_O0": "ON"
      }
    },
    {
      "name": "bench",
      "inherits": "base",
      "displayName": "Release benchmark scaffold",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "JARVIS_BUILD_TESTS": "OFF",
        "JARVIS_BUILD_BENCHMARKS": "ON",
        "JARVIS_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "Debug with ThreadSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JARVIS_BUILD_PYTHON": "OFF",
        "JARVIS_BUILD_TESTS": "ON",
        "JARVIS_BUILD_BENCHMARKS": "OFF",
        "JARVIS_ENABLE_SANITIZERS": "OFF",
        "JARVIS_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer targets (Clang only)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "JARVIS_BUILD_PYTHON": "OFF",
        "JARVIS_BUILD_TESTS": "OFF",
        "JARVIS_BUILD_BENCHMARKS": "OFF",
        "JARVIS_ENABLE_SANITIZERS": "OFF",
        "JARVIS_ENABLE_FUZZ": "ON"
      }
    },
    {
      "name": "win-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl",
        "JARVIS_BUILD_TESTS": "ON",
        "JARVIS_BUILD_BENCHMARKS": "OFF",
        "JARVIS_ENABLE_SANITIZERS": "OFF",
        "CMAKE_C_COMPILER": "clang-cl"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "win-dev",
      "inherits": "win-base",
      "displayName": "Windows Debug with clang-cl (from a VS developer prompt)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-rel",
      "inherits": "win-base",
      "displayName": "Windows Release with clang-cl (from a VS developer prompt)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-dev",
      "inherits": "base",
      "displayName": "Windows Debug with MinGW-w64 GCC (MSYS2 MINGW64 shell)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "JARVIS_BUILD_PYTHON": "OFF",
        "JARVIS_BUILD_TESTS": "ON",
        "JARVIS_BUILD_BENCHMARKS": "OFF",
        "JARVIS_ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "mingw-cross",
      "inherits": "base",
      "displayName": "Windows cross build from Linux with MinGW-w64; tests under Wine",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JARVIS_BUILD_PYTHON": "OFF",
        "JARVIS_BUILD_TESTS": "ON",
        "JARVIS_BUILD_BENCHMARKS": "OFF",
        "JARVIS_ENABLE_SANITIZERS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "rel",
      "configurePreset": "rel"
    },
    {
      "name": "det-o0",
      "configurePreset": "det-o0"
    },
    {
      "name": "bench",
      "configurePreset": "bench",
      "targets": [
        "jarvis_bench"
      ]
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": [
        "jarvis_fuzz"
      ]
    },
    {
      "name": "win-dev",
      "configurePreset": "win-dev"
    },
    {
      "name": "win-rel",
      "configurePreset": "win-rel"
    },
    {
      "name": "mingw-dev",
      "configurePreset": "mingw-dev"
    },
    {
      "name": "mingw-cross",
      "configurePreset": "mingw-cross"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "rel",
      "configurePreset": "rel",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "det-o0",
      "configurePreset": "det-o0",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-dev",
      "configurePreset": "win-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-rel",
      "configurePreset": "win-rel",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-dev",
      "configurePreset": "mingw-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mingw-cross",
      "configurePreset": "mingw-cross",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
