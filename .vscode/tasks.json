{
  "version": "2.0.0",
  "tasks": [
    {
      // The examples refuse to write into a run directory that already holds a run log
      // (AlreadyExists), so the debug configurations that write runs/mm-dbg clear it first.
      "label": "clean runs/mm-dbg",
      "type": "process",
      "command": "rm",
      "args": ["-rf", "${workspaceFolder}/runs/mm-dbg"],
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    }
  ]
}
